SERVER_PORT=

DATABASE_URL=

# Reuse the deployment's S3/MinIO connection; never put source in a public media bucket.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
FILES_S3_BUCKET=project-files
FILES_S3_AUTO_CREATE_BUCKET=true
FILES_GC_ENABLED=true
FILES_GC_GRACE_HOURS=24
