PORT=8082

APP_NAME=

OTEL_EXPORTER_OTLP_ENDPOINT=

RABBITMQ_URL=

DATABASE_URL=

DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# S3-compatible profile image storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=user-media
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
S3_PUBLIC_READ=true

# Profile image processing, garbage collection, and per-instance upload quota
PROFILE_IMAGE_GC_ENABLED=true
PROFILE_IMAGE_GC_GRACE_HOURS=24
PROFILE_IMAGE_UPLOAD_LIMIT=5
PROFILE_IMAGE_UPLOAD_WINDOW_SECONDS=60
# Postgres connection pool (node-postgres). Tune per infra:
# self-hosted VPS -> keep max under Postgres max_connections across all instances
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
