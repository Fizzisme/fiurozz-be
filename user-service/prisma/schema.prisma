// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  UNKNOWN
  MALE
  FEMALE
  OTHER
}

enum SocialPlatform {
  GITHUB
  GITLAB
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  TWITTER
  YOUTUBE
  DISCORD
  WEBSITE
  DRIBBBLE
  BEHANCE
  OTHER
}

enum Occupation {
  STUDENT
  FRONTEND_DEVELOPER
  BACKEND_DEVELOPER
  FULLSTACK_DEVELOPER
  MOBILE_DEVELOPER
  SOFTWARE_ENGINEER
  DEVOPS_ENGINEER
  DATA_ENGINEER
  DATA_ANALYST
  UI_UX_DESIGNER
  PRODUCT_MANAGER
  QA
  AI_ENGINEER
  BA
  OTHER
}

model User {
  id String @id @db.Uuid
  profile   UserProfile?
  settings  UserSetting?
  stats     UserStats?
  links     SocialLink[]
  skills    UserSkill[]

  // Directed follow graph: `following` = edges this user created,
  // `followers` = edges pointing at this user. Two relations over the
  // same table, so both need an explicit name.
  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt, createdAt])
  @@map("users")
}

model UserProfile {
  userId String @id @db.Uuid

  email String @unique

  displayName String @unique @map("display_name") @db.VarChar(100)

  fullName String? @map("full_name") @db.VarChar(150)

  avatarUrl String? @map("avatar_url")

  coverUrl String? @map("cover_url")

  bio String? @db.VarChar(500)

  occupation Occupation?

  company String? @db.VarChar(100)

  location String? @db.VarChar(100)

  birthday DateTime? @db.Date

  website String?

  gender Gender @default(UNKNOWN)

  language String @default("en") @db.VarChar(10)

  timezone String @default("UTC") @db.VarChar(50)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSetting {
  userId String @id @db.Uuid

  isPrivate Boolean @default(false) @map("is_private")

  showEmail Boolean @default(true) @map("show_email")

  showBirthday Boolean @default(true) @map("show_birthday")

  allowMessage Boolean @default(true) @map("allow_message")

  locale String @default("en")

  theme String @default("system")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model SocialLink {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  platform SocialPlatform

  title String? @db.VarChar(50)

  url String

  order Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("social_links")
}

model Skill {
  id String @id @default(uuid()) @db.Uuid

  name String @unique @db.VarChar(50)

  users UserSkill[]

  @@map("skills")
}

// One row per directed edge: `follower` follows `followee`.
// No accept step -- following is one-way, and "friendship" is derived
// as a mutual pair of edges rather than stored. Private accounts
// (UserSetting.isPrivate) are not honoured yet; that needs a status
// column and is deliberately left for a later migration.
model Follow {
  followerId String @map("follower_id") @db.Uuid

  followeeId String @map("followee_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  follower User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)

  followee User @relation("Followers", fields: [followeeId], references: [id], onDelete: Cascade)

  // PK doubles as the uniqueness guard (can't follow someone twice) and
  // as the index for a single "does A follow B?" lookup.
  @@id([followerId, followeeId])
  // Both list directions are paginated newest-first by keyset, so each
  // index carries createdAt to serve the ORDER BY from the index alone.
  @@index([followeeId, createdAt])
  @@index([followerId, createdAt])
  @@map("follows")
}

// Follower/following counts, denormalized out of `follows` because
// COUNT(*) over the edge table runs on every profile render.
// Kept in its own table rather than on UserProfile so that a follow by
// someone else doesn't lock the row the owner updates via PATCH /me.
// Written in the same transaction as the edge; drift is possible if a
// write is interrupted, so these are reconcilable from `follows` alone.
model UserStats {
  userId String @id @map("user_id") @db.Uuid

  followersCount Int @default(0) @map("followers_count")

  followingCount Int @default(0) @map("following_count")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model UserSkill {
  userId String @map("user_id") @db.Uuid

  skillId String @map("skill_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}